# ============================================================
# 益栈环境变量
# ============================================================

# AI 通道配置（MiMo 官方 API，OpenAI 兼容，全模态理解用 mimo-v2.6-flash）
# AI 调用只在服务端进行，key 不会下发到浏览器。
# 官方 OpenAI 兼容端点：https://api.xiaomimimo.com/v1/chat/completions
AI_BASE_URL=https://api.xiaomimimo.com/v1/chat/completions
AI_MODEL=mimo-v2.6-flash
AI_API_KEY=

# ISBN 图书检索（第三方 API：isbn.xiaoxi.ac.cn）
# key 只在服务端读取，不下发浏览器。在 https://isbn.xiaoxi.ac.cn/account 免费申请。
ISBN_API_BASE=https://isbn.xiaoxi.ac.cn
ISBN_API_KEY=

# 微信开放平台「网站应用」扫码登录（snsapi_login）
# 仅在同时配置下面两项时启用；未配置则前端不显示微信按钮，邮箱注册/登录照常可用。
# ⚠️ 申请前提：微信开放平台网站应用需【企业主体 + 认证(¥300/年)】，且回调域必须是
#    【已备案域名 + HTTPS】。当前裸 IP + HTTP 部署无法使用，取得资质/域名后再填。
# 配置方式：open.weixin.qq.com → 网站应用 → 设置「授权回调域」为你的域名。
# WECHAT_CLIENT_ID=
# WECHAT_CLIENT_SECRET=

# Better Auth 配置
# 生成方式: openssl rand -base64 32
BETTER_AUTH_SECRET=
# 部署时的公开访问地址（开发可留空；留空则自动按请求 Host 识别）
# BETTER_AUTH_URL=http://localhost:3000
# 公开端地址（用于 auth-client、回执/捐赠二维码，客户端优先用当前页面地址）
# ⚠️ NEXT_PUBLIC_APP_URL 决定回执标签/捐赠登记二维码的跳转地址，务必设成手机/顾客能访问的
# 对外地址（局域网 IP / 公网 IP / 域名），否则从 localhost 打印的二维码会让手机扫出 localhost。
# NEXT_PUBLIC_APP_URL=http://localhost:3000
#
# Secure cookie 开关（仅公网裸 IP + HTTP 部署需要）
# 生产默认按 HTTPS 开 Secure cookie；若用公网裸 IP（无证书、走 HTTP），登录会因
# Secure cookie 不被发送而失效，请设 BETTER_AUTH_USE_SECURE_COOKIES=false。
# true=强制开（仅 HTTPS），false=强制关（裸 IP/HTTP），留空=按生产自动判断。
# BETTER_AUTH_USE_SECURE_COOKIES=false
#
# —— 局域网访问说明 ——
# 用另一台设备（手机/电脑）访问时：把 BETTER_AUTH_URL / NEXT_PUBLIC_APP_URL 改成
# http://<本机局域网IP>:3000（如 http://192.168.1.2:3000），用 `npm run dev:lan` 启动
# （绑定 0.0.0.0），并放行 Windows 防火墙 3000 端口入站。
# 开发态已在 trustedOrigins 加了 http://*:3000 通配，即使不改这两个地址也能在局域网登录，
# 但正式部署请务必把 BETTER_AUTH_URL 设为公网地址。

# 数据库
# SQLite 默认 data/yizhan.db（DATA_DIR 可改目录）
# DATABASE_DIR=./data
# DATABASE_URL=

# 日志保留天数（默认 30 天）
# LOG_RETENTION_DAYS=30

# 预置店长账号（seed 脚本用；不设密码则随机生成并打印）
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me